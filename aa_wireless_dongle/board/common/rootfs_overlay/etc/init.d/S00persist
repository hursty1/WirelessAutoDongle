#!/bin/sh
#
# Setup persistent storage
#

case "$1" in
	start)
		echo "Setup persistent storage..."
		mkdir -p /persist/seedrng
		mkdir -p /persist/bluetooth
		mkdir -p /persist/dropbear
		/usr/sbin/aawg-logs init || echo "Persistent logging initialization failed; check /var/log/messages"
		;;
	*)
		echo "Usage: $0 {start}"
		exit 1
esac

exit $?
