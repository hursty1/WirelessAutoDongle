#!/bin/sh
#
# Start aawgd daemon
#

DAEMON="aawgd"
PIDFILE="/var/run/$DAEMON.pid"


RETVAL=0

case "$1" in
	start)
		if [ -z "$AAWG_CONF_SOURCED" ]; then
			echo "Source /etc/aawgd.conf"
			source /etc/aawgd.conf
		fi

		printf "Starting $DAEMON: "
		if [ "${AAWG_MODE:-android}" = carplay-probe ]; then
			echo 'Skipped (CarPlay handshake probe mode)'
			exit 0
		fi
		/usr/sbin/aawg-logs event android daemon START 'Starting Android Auto diagnostic profile'
		start-stop-daemon -S -b -q -m -p "$PIDFILE" -x "/usr/bin/$DAEMON"
		RETVAL=$?
		/usr/sbin/aawg-logs event android daemon LAUNCH_RESULT "start-stop-daemon exit=$RETVAL"
		[ $RETVAL = 0 ] && echo "OK" || echo "FAIL"
		;;
	stop)
		printf "Stopping $DAEMON: "
		start-stop-daemon -K -q -p "$PIDFILE"
		RETVAL=$?
		[ $RETVAL = 0 ] && echo "OK" || echo "FAIL"
		;;
	restart)
		$0 stop
		$0 start
		;;
	*)
		echo "Usage: $0 {start|stop}"
		;;
esac

exit $RETVAL
