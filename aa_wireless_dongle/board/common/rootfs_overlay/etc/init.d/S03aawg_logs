#!/bin/sh

case "$1" in
    start)
        start-stop-daemon -S -b -m -p /run/aawg-logs/watcher.pid \
            -x /usr/sbin/aawg-logs -- watch
        ;;
    stop)
        /usr/sbin/aawg-logs event boot shutdown START 'Orderly shutdown requested'
        start-stop-daemon -K -p /run/aawg-logs/watcher.pid || true
        sync
        ;;
    *) echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
